+        // ---- ship glow (persistent bitmask; the glow only shows while PILOTING, driven by the server) ----
+        private static bool IsShipGlowActive(string key)
+        {
+            int bit = ShipGlowManager.BitFor(key);
+            Profile prof = ProfileManager.CurrentProfile;
+            return bit >= 0 && prof != null && (prof.StoreShipGlowMask & (1 << bit)) != 0;
+        }
+
+        private static void ApplyShipGlow(World world, string key)
+        {
+            int bit = ShipGlowManager.BitFor(key);
+            Profile prof = ProfileManager.CurrentProfile;
+            if (bit < 0 || prof == null)
+                return;
+            prof.StoreShipGlowMask |= (1 << bit);
+            PushShipGlow(world);
+            GameActions.Print(world, "[Store] Ship glow applied — board the ship and take the helm to see it.");
+        }
+
+        private static void RemoveShipGlow(World world, string key)
+        {
+            int bit = ShipGlowManager.BitFor(key);
+            Profile prof = ProfileManager.CurrentProfile;
+            if (bit < 0 || prof == null)
+                return;
+            prof.StoreShipGlowMask &= ~(1 << bit);
+            PushShipGlow(world);
+            GameActions.Print(world, "[Store] Ship glow removed.");
+        }
+
+        // Publish my applied ship-glow bitmask to the server (it decides, on piloting, which ship glows for everyone).
+        public static void PushShipGlow(World world)
+        {
+            Profile prof = ProfileManager.CurrentProfile;
+            ushort mask = (ushort)(prof?.StoreShipGlowMask ?? 0);
+            AsyncNetClient.Socket?.Send_ShipGlow(mask);
+        }
+
