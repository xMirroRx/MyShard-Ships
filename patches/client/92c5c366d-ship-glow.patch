+    // Client -> server: publish your applied Store ship-glow bitmask (one bit per ship type). The server keeps it
+    // and, when you take the helm of a matching ship, tells everyone to glow that ship. 0 = none.
+    public static void Send_ShipGlow(this AsyncNetClient socket, ushort mask)
+    {
+        StackDataWriter f = Extensions.GetWriter(EnhancedPacketType.ShipGlow);
+        ref StackDataWriter writer = ref f;
+
+        writer.WriteUInt16BE(mask);
+
+        writer.FinalLength();
+        socket.Send(writer.BufferWritten, true);
+        writer.Dispose();
+    }
+
