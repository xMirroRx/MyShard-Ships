@@ -0,0 +1,30 @@
+using System.Collections.Generic;
+
+namespace ClassicUO.Game.Managers
+{
+    /// <summary>
+    /// Store-purchased MOUNT DYE. A player buys a UO hue in the Store and applies it; while they RIDE any mount, the
+    /// mount is recoloured to that hue for everyone. Like the weapon glow it is keyed per RIDER (mobile serial) — the
+    /// dye follows the player onto whatever mount they ride — and broadcast to every client. This manager holds
+    /// rider-serial -> hue (0 = none). The renderer (MobileView) recolours ONLY the mount, not the rider.
+    /// </summary>
+    public static class MountDyeManager
+    {
+        // rider (mobile) serial -> applied mount dye hue.
+        private static readonly Dictionary<uint, ushort> _dye = new();
+
+        /// <summary>Set/clear a rider's mount dye hue (server-driven, by serial). hue 0 = clear.</summary>
+        public static void SetDye(uint serial, ushort hue)
+        {
+            if (hue == 0)
+                _dye.Remove(serial);
+            else
+                _dye[serial] = hue;
+        }
+
+        /// <summary>Applied mount dye hue for this rider, or 0 if none.</summary>
+        public static ushort GetDye(uint serial) => _dye.TryGetValue(serial, out ushort h) ? h : (ushort)0;
+
+        public static void Clear() => _dye.Clear();
+    }
+}
