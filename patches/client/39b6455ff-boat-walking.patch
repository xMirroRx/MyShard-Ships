                     //entity.BoatDirection = direction;
 
+                    // The local player is carried by the boat's delta (see ShiftPlayer); while he walks on deck his own
+                    // walk animation offset is kept instead of the boat's interpolation offset.
+                    if (entity == _world.Player)
+                    {
+                        if (removeStep)
+                        {
+                            ShiftPlayer(dx, dy, dz);
+                            if (_world.Player.Steps.Count == 0)
+                            {
+                                entity.Offset.X = 0;
+                                entity.Offset.Y = 0;
+                                entity.Offset.Z = 0;
+                            }
+                        }
+                        else if (item != null)
+                        {
+                            if (_world.Player.Steps.Count == 0)
+                            {
+                                entity.Offset = item.Offset;
+                            }
+                            else
+                            {
+                                // Walking on deck: World.Update already set this frame's walk-animation offset; add the
+                                // boat's glide on top so the player moves with the ship instead of lagging and then
+                                // jumping a tile when the boat step completes.
+                                entity.Offset.X += item.Offset.X;
+                                entity.Offset.Y += item.Offset.Y;
+                                entity.Offset.Z += item.Offset.Z;
+                            }
+                        }
+
+                        continue;
+                    }
+
