             }
         }
 
+        // MyShard: the local player aboard a moving boat is carried by the boat's DELTA, never snapped to the absolute
+        // position in the boat packet. That position is the server's view at send time and does not include steps the
+        // player walked on deck that the server hasn't confirmed yet; snapping (and the walker reset that came with it)
+        // threw the player back each boat step — walking on a moving ship stuttered. The pending walk steps (Walker
+        // StepInfos) and the walk animation targets (Steps) are shifted by the same delta so they stay consistent.
+        public void ShiftPlayer(int dx, int dy, int dz)
+        {
+            PlayerMobile p = _world.Player;
+            if (p == null || (dx == 0 && dy == 0 && dz == 0))
+                return;
+
+            p.X = (ushort)(p.X + dx);
+            p.Y = (ushort)(p.Y + dy);
+            p.Z = (sbyte)(p.Z + dz);
+            p.UpdateScreenPosition();
+            p.AddToTile();
+
+            for (int i = 0; i < p.Steps.Count; i++)
+            {
+                ref Mobile.Step s = ref p.Steps.GetAt(i);
+                s.X += dx;
+                s.Y += dy;
+                s.Z = (sbyte)(s.Z + dz);
+            }
+
+            for (int i = 0; i < p.Walker.StepsCount; i++)
+            {
+                ref StepInfo si = ref p.Walker.StepInfos[i];
+                si.X = (ushort)(si.X + dx);
+                si.Y = (ushort)(si.Y + dy);
+                si.Z = (sbyte)(si.Z + dz);
+            }
+
+            _world.RangeSize.X += dx;
+            _world.RangeSize.Y += dy;
+        }
+
         public void MoveRequest(Direction direciton, byte speed)
         {
             AsyncNetClient.Socket.Send_MultiBoatMoveRequest(_world.Player, direciton, speed);
