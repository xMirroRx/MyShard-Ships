         public bool IsCorpse => /*MathHelper.InRange(Graphic, 0x0ECA, 0x0ED2) ||*/
             Graphic == 0x2006;
 
+        // The server marks gather corpses with both protocol hue flag bits.
+        // The marker is stripped in FixHue so it never changes the corpse's appearance.
+        public bool SuppressAutomaticCorpseOpen { get; private set; }
+
+        public override void FixHue(ushort hue)
+        {
+            SuppressAutomaticCorpseOpen = IsCorpse && (hue & 0xC000) == 0xC000;
+
+            if (SuppressAutomaticCorpseOpen)
+            {
+                hue &= 0x3FFF;
+            }
+
+            base.FixHue(hue);
+        }
+
         public bool IsHumanCorpse => IsCorpse &&
             MathHelper.InRange(Amount, 0x0190, 0x0193) ||
             MathHelper.InRange(Amount, 0x00B7, 0x00BA) ||
diff --git a/src/ClassicUO.Client/Game/Managers/BoatMovingManager.cs b/src/ClassicUO.Client/Game/Managers/BoatMovingManager.cs
