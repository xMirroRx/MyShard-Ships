@@ -4299,6 +4299,28 @@ PacketWeaponGlow::PacketWeaponGlow(const CClient* target, dword serial, word mas
 	push(target);
 }
 
+/***************************************************************************
+ *
+ *
+ *	Packet 0xCE : PacketShipGlowState	(custom) MyShard: a ship (serial) glow on/off -> every online player sees
+ *										the whole ship light up while its pilot has the helm.
+ *
+ *
+ ***************************************************************************/
+PacketShipGlowState::PacketShipGlowState(const CClient* target, dword shipSerial, byte on)
+	: PacketSend(0xCE, 0, PRI_NORMAL)
+{
+	ADDTOCALLSTACK("PacketShipGlowState::PacketShipGlowState");
+
+	initLength();			// 2-byte length, finalized on send
+	writeInt16(35);			// EnhancedPacketType.ShipGlowState
+	writeInt16(0);			// version
+	writeInt32(shipSerial);	// the ship (multi item) that should glow
+	writeByte(on);			// 1 = glow on, 0 = off
+
+	push(target);
+}
+
 /***************************************************************************
  *
  *
diff --git a/src/network/send.h b/src/network/send.h
index 3ca1b703..3a4e1d7d 100644
--- a/src/network/send.h
+++ b/src/network/send.h
@@ -1666,6 +1666,20 @@ public:
 	PacketWeaponGlow(const CClient* target, dword serial, word mask);
 };
 
+/***************************************************************************
+ *
+ *
+ *	Packet 0xCE : PacketShipGlowState	(custom) MyShard: a ship (serial) glow on/off, sent to every online player
+ *										so the whole ship lights up while its pilot (who applied the glow) has the helm.
+ *
+ *
+ ***************************************************************************/
+class PacketShipGlowState : public PacketSend
+{
+public:
+	PacketShipGlowState(const CClient* target, dword shipSerial, byte on);
+};
+
 /***************************************************************************
